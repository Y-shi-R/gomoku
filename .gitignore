# Godot 4 项目 .gitignore
# ------------------------------------------------------------
# 说明：.godot/ 是导入缓存，体积大且可自动重建，不纳入版本管理。
# addons/godot_ai/ 是开发时用的编辑器插件（约 325 个文件），
#   游戏本身不依赖它，删掉也能正常运行，故不推送。

# Godot 编辑器缓存
.godot/
*.translation

# 开发用编辑器插件（游戏不依赖，删掉不影响运行）
addons/

# 编辑器/导出过程中的备份文件
*.devbak
*.mcpbak
*.export

# 导出产物（体积大，GitHub 单文件上限 100MB）
build/
*.exe
*.pck
*.zip

# 系统与编辑器杂项
Thumbs.db
desktop.ini
.DS_Store
*.tmp
*.log

# 编辑器本地配置
*.cfg.bak
export_credentials.cfg
